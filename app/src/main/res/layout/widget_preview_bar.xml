<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Progress bar widget, with sample numbers. Used whenever the
     launcher has no generated preview (see WidgetPreviews.kt). Only RemoteViews-safe views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="48 / 80 oz"
            android:textColor="@color/preview_on_surface"
            android:textSize="15sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="60"
            android:progressBackgroundTint="@color/preview_primary_container"
            android:progressBackgroundTintMode="src_in"
            android:progressTint="@color/preview_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/preview_button"
        android:gravity="center"
        android:text="+8"
        android:textColor="@color/preview_on_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/preview_button"
        android:gravity="center"
        android:text="+16"
        android:textColor="@color/preview_on_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
